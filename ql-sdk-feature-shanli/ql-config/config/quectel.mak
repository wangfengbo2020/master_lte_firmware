			QUEC_TARGET_DFLAGS  += -DFEATURE_QUECTEL_LOCATOR_APP
			QUEC_TARGET_DFLAGS  += -DQUEC_ASR_SMS_ENABLE
			QUEC_TARGET_DFLAGS  += -DQUEC_MQTT_SUPPORT
			QUEC_TARGET_DFLAGS  += -DQUEC_FTP_SUPPORT
			QUEC_TARGET_DFLAGS  += -DQUEC_HTTP_SUPPORT
			QUEC_TARGET_DFLAGS  += -DQUEC_PPP_ENABLE
	endif

	VARIANT_LIST        += NOAUDIO NOIMS
	VARIANT_LIST        += CAT1ONLY_THIN NOATNET NOXML SD_NOT_SUPPORT NOPMIC813 NOPMICONKEY NOOSSL REMOVE_PB
	VARIANT_LIST        += NOLWM2M NOPAHO NOPMIC802
	
endif

#EC800MCN_MC 2M+4M 项目 ASR-CRANEL
ifneq (,$(findstring EC800MCN_MC,${QUECTEL_PROJECT})) 
	QUEC_TARGET_DFLAGS  += -DQUEC_NOAUDIO -D__CMUX_DISABLE
	QUEC_TARGET_DFLAGS  += -DQUEC_TTS_NOT_SUPPORT 
