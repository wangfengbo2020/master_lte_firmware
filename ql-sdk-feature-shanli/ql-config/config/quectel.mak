#EC800MCN_GC 4M+4M 项目 ASR-CRANEL，4M Flash支持GNSS的版本
ifneq (,$(findstring EC800MCN_GC,${QUECTEL_PROJECT}))
	QUEC_TARGET_DFLAGS  += -DQUEC_NOAUDIO
	QUEC_TARGET_DFLAGS  += -DQUEC_TTS_NOT_SUPPORT
	QUEC_TARGET_DFLAGS  += -DQUEC_AMR_NOT_SUPPORT -DQUEC_CUST_FOR_IPC_SUPPORT
	
	QUEC_TARGET_DFLAGS  += -DQUEC_PPP_ENABLE
	QUEC_TARGET_DFLAGS  += -DQUEC_ASR_SMS_ENABLE -DNO_MBEDTLS
	QUEC_TARGET_DFLAGS	+= -DQUEC_UART_DMA_TX_ENABLE -DQUEC_UART_DMA_RX_ENABLE

	VARIANT_LIST        += NOAUDIO NOIMS NODIALER NOHTTPS NOTLS
	VARIANT_LIST        += CAT1ONLY_THIN NOATNET NOXML SD_NOT_SUPPORT NOPMIC813 NOPMICONKEY NOOSSL REMOVE_PB
	VARIANT_LIST        += NOLWM2M NOPAHO NOPMIC802
	
	
	ifeq (,$(findstring MIN_SYS,${VARIANT_LIST}))
		PACKAGE_LIST +=  \
			quectel/gnss
		
		VARIANT_LIST  += HX_GPS	
		TARGET_DFLAGS += -DHX_GNSS_SUPPORT -DQUEC_AT_GPS_ENABLE 
		
		#add for 宇松gnss定制需求
		ifneq (,$(findstring BPC,${oem_ver}))
			QUEC_TARGET_DFLAGS  += -DYS_GNSS_SUPPORT
		endif
	endif

endif

