	VARIANT_LIST        += NOAUDIO NOIMS LFS_SUPPORT_V2 NOL1WIFI
	VARIANT_LIST        += CAT1ONLY_THIN NOATNET NOXML SD_NOT_SUPPORT NOPMIC813 NOPMICONKEY NOOSSL REMOVE_PB
