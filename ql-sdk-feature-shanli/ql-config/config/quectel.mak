# 使用注意事项
# QUEC_TARGET_DFLAGS 用于增加大功能宏定义
# TARGET_ARMLINK_OPT 用于定义链接阶段的宏
# VARIANT_LIST       用于控制某些功能的C源文件是否参与编译
# LZMA_SUPPORT-------控制LZMA代码进行编译
#######################################################################

$(warning ${QUECTEL_PROJECT_DEF})

QUEC_VARIANT_LIST := $(strip ${oem_ver})

QUEC_TARGET_DFLAGS := -DEXT_AT_MODEM_SUPPORT -DSUPPORT_FBP -DQUEC_START_UP

ifneq (,$(findstring CRANEM,${ASR_PLATFORM}))
	#1603(1603S/1603E/1603C)
	QUEC_TARGET_DFLAGS  += -DASR_PLATFORM_CRANEM
else
	ifneq (,$(findstring CRANELR,${ASR_PLATFORM}))
		#1602
		QUEC_TARGET_DFLAGS  += -DASR_PLATFORM_CRANELR
	else	
		ifneq (,$(findstring CRANELS,${ASR_PLATFORM}))
			QUEC_TARGET_DFLAGS  += -DASR_PLATFORM_CRANELS
		else
			#1606(1606C/1606S/1606L)
			QUEC_TARGET_DFLAGS  += -DASR_PLATFORM_CRANEL
		endif
	endif
endif
		
ifneq (,$(findstring TRUE,${QUEC_OPEN_DEF}))
########################################################################
##
##OPEN项目功能控制
########################################################################

QUEC_TARGET_DFLAGS  += -DQUECTEL_OPEN_CPU -DMP3_DECODE -DQUEC_USB_CDC_SUPPORT -DQUEC_LCD_SUPPORT -DEXTERNAL_SPI_NORFLASH_FS -DQUEC_KEYPAD_SUPPORT -DQUEC_DUMP_NVM_SUPPORT
QUEC_TARGET_DFLAGS  += -DQUEC_UART_DMA_TX_ENABLE -DQUEC_UART_DMA_RX_ENABLE 
#此宏用于使能音频降噪算法,内核默认开启,客户SDK使用QL_AUDIO_DENOISE宏来裁剪掉
QUEC_TARGET_DFLAGS  += -DQUEC_AUDIO_DENOISE
#此宏用于使能KWS语音识别算法,内核默认开启,客户SDK使用QL_AUDIO_KWS宏来裁剪掉
QUEC_TARGET_DFLAGS  += -DQUEC_AUDIO_KWS


ifneq (,$(findstring DM,${oem_ver}))
  QUEC_TARGET_DFLAGS += -DREMOVE_SMS
endif  
VARIANT_LIST        += NOPMIC802 NOPMIC813 NOLWM2M NOPAHO SD_NOT_SUPPORT NOATNET MP3_DECODE AES_SUPPORT QUECTEL_OPEN_CPU LZMA_SUPPORT ALIPAY
## Due to hid and mass storage use the same endpoints, 
## only enable one function between USB2_HID_SUPPORT and MASS_STORAGE 
##VARIANT_LIST 		+= USB2_HID_SUPPORT

TARGET_ARMLINK_OPT  += --predefine="-DQUECTEL_OPEN_CPU"

##OEM=IMS支持IMS的内核版本(IMS+SMS)
ifneq (,$(findstring IMS,${oem_ver}))
	QUEC_TARGET_DFLAGS  += -DQUEC_ASR_SMS_ENABLE
	QUEC_TARGET_DFLAGS  += -DQUEC_TTS_NOT_SUPPORT -DQUEC_GNSS_SUPPORT
	QUEC_TARGET_DFLAGS  += -DQUEC_CAMERA_SUPPORT 
	
	ifeq (,$(findstring MIN_SYS,${VARIANT_LIST}))
	PACKAGE_LIST +=  \
		quectel/lcd \
		quectel/camera \
		quectel/gnss \
		quectel/yaffs2\
		quectel/slas\
		quectel/wsclient
	endif
	VARIANT_LIST  += HX_GPS	QUEC_SPI_NAND 
	TARGET_DFLAGS += -DHX_GNSS_SUPPORT -DQUEC_NAND_YAFFS 
endif

##OEM=THIN 精简版本内核
ifneq (,$(findstring THIN,${oem_ver}))
	VARIANT_LIST        += NOHTTPS NOTLS NODIALER NO_MBEDTLS NOIMS REMOVE_SMS REMOVE_PB
	QUEC_TARGET_DFLAGS  += -DQUEC_MINSYS_THIN -DQUEC_TTS_NOT_SUPPORT -DNO_MBEDTLS
	TARGET_ARMLINK_OPT  += --predefine="-DQUEC_MINSYS_THIN"
endif

##OEM=BL 宝蓝客户定制版本(MQTT AT、双卡、)
ifneq (,$(findstring BL,${oem_ver}))
	VARIANT_LIST        += NOIMS REMOVE_SMS REMOVE_PB
	QUEC_TARGET_DFLAGS  += -DQUEC_MQTT_SUPPORT
	
	#宝蓝客户定制项目宏
	QUEC_TARGET_DFLAGS  += -DQUEC_CUST_BL_PROJ 
	
	ifeq (,$(findstring MIN_SYS,${VARIANT_LIST}))
		PACKAGE_LIST +=  \
			quectel/lcd \
			quectel/gnss
			
	endif
	VARIANT_LIST  += HX_GPS	
	TARGET_DFLAGS += -DHX_GNSS_SUPPORT 
endif

##OEM=SIMB sim2引脚不控制ldo8电压域版本
ifneq (,$(findstring SIMB,${oem_ver}))
	VARIANT_LIST        += NOIMS REMOVE_SMS REMOVE_PB
	QUEC_TARGET_DFLAGS  += -DQUEC_CAMERA_SUPPORT -DQUEC_GNSS_SUPPORT
	##删除sim2脚定制宏
	QUEC_TARGET_DFLAGS  += -DQUEC_OEM_VER_SIMB
	
	ifeq (,$(findstring MIN_SYS,${VARIANT_LIST}))
		PACKAGE_LIST +=  \
			quectel/lcd \
			quectel/camera \
			quectel/gnss\
			quectel/slas\
			quectel/wsclient

	endif
	VARIANT_LIST  += HX_GPS	
	TARGET_DFLAGS += -DHX_GNSS_SUPPORT 
endif

##OEM 为空默认为公版 默认使用和芯gps yaffs文件系统功能打开
ifeq (,$(oem_ver)) 
	VARIANT_LIST        += NOIMS REMOVE_SMS REMOVE_PB
	QUEC_TARGET_DFLAGS  += -DQUEC_CAMERA_SUPPORT -DQUEC_GNSS_SUPPORT 
	
	ifeq (,$(findstring MIN_SYS,${VARIANT_LIST}))
		PACKAGE_LIST +=  \
			quectel/lcd \
			quectel/camera \
			quectel/gnss \
			quectel/yaffs2\
			quectel/slas\
			quectel/wsclient

		ifneq (,$(findstring BT,${flash_layout_type}))##外挂bt项目
	     	
			VARIANT_LIST  += BT_SUPPORT BT_STACK_SUPPORT
			QUEC_TARGET_DFLAGS  += -DQUEC_BT_PRODUCIBILITY
		endif
	endif
	VARIANT_LIST  += HX_GPS	QUEC_SPI_NAND
	TARGET_DFLAGS += -DHX_GNSS_SUPPORT -DQUEC_NAND_YAFFS 
endif

#ASR_GPS 需要使用ASR GPS使能此OEM
ifneq (,$(findstring ASR_GPS_BT,${oem_ver}))
	VARIANT_LIST        += NOIMS REMOVE_SMS REMOVE_PB
	QUEC_TARGET_DFLAGS  += -DQUEC_CAMERA_SUPPORT -DQUEC_GNSS_SUPPORT 
	ifeq (,$(findstring MIN_SYS,${VARIANT_LIST}))
		PACKAGE_LIST +=  \
			quectel/lcd \
			quectel/camera \
			quectel/gnss \
			quectel/slas\
			quectel/wsclient

		VARIANT_LIST  += QUEC_ASR_GPS AGPSTP_SUPPORT BT_SUPPORT BT_STACK_SUPPORT
		TARGET_DFLAGS += -DQUEC_GPS_SUPPORT  -DQUEC_ASR_GNSS_SUPPORT -DGPS_SUPPORT
		QUEC_TARGET_DFLAGS  +=-DQUEC_BT_PRODUCIBILITY
	endif

endif

##OEM=IMS支持IMS的内核版本(IMS+SMS)
ifneq (,$(findstring CAC,${oem_ver}))
	VARIANT_LIST += NODIALER UAC_SUPPORT
	PMIC_RF_T +=  NOBIP
	QUEC_TARGET_DFLAGS  += -DQUEC_ASR_SMS_ENABLE  -UQUEC_USB_CDC_SUPPORT -DQUEC_OEM_CAC
endif

else	
########################################################################
##
##STD项目功能控制
########################################################################

##----------------------------- CUSTOMIZ -------------------------------
##项目定制功能

#EC600M,EC800M,EG810M,EC600K,EC800K支持WIFI OEM宏
ifneq (,$(findstring EC600M,${QUECTEL_PROJECT})) 
ifneq (,$(findstring WIFI,${oem_ver}))
	QUEC_TARGET_DFLAGS  += -DQUEC_FGM842D_WIFI_SUPPORT
	QUEC_TARGET_DFLAGS  += -DQUEC_UART_DMA_RX_ENABLE -DQUEC_UART_DMA_TX_ENABLE
	QUEC_TARGET_DFLAGS  += -DQUEC_BT_UART_DMA_TX_ENABLE -DQUEC_BT_UART_DMA_RX_ENABLE
endif
endif

ifneq (,$(findstring EC800M,${QUECTEL_PROJECT})) 
ifneq (,$(findstring WIFI,${oem_ver}))
	QUEC_TARGET_DFLAGS  += -DQUEC_FGM842D_WIFI_SUPPORT
	QUEC_TARGET_DFLAGS  += -DQUEC_UART_DMA_RX_ENABLE -DQUEC_UART_DMA_TX_ENABLE
	QUEC_TARGET_DFLAGS  += -DQUEC_BT_UART_DMA_TX_ENABLE -DQUEC_BT_UART_DMA_RX_ENABLE
endif
endif

ifneq (,$(findstring EG810M,${QUECTEL_PROJECT})) 
ifneq (,$(findstring WIFI,${oem_ver}))
	QUEC_TARGET_DFLAGS  += -DQUEC_FGM842D_WIFI_SUPPORT
	QUEC_TARGET_DFLAGS  += -DQUEC_UART_DMA_RX_ENABLE -DQUEC_UART_DMA_TX_ENABLE
	QUEC_TARGET_DFLAGS  += -DQUEC_BT_UART_DMA_TX_ENABLE -DQUEC_BT_UART_DMA_RX_ENABLE
endif
endif

ifneq (,$(findstring EC600K,${QUECTEL_PROJECT})) 
ifneq (,$(findstring WIFI,${oem_ver}))
	QUEC_TARGET_DFLAGS  += -DQUEC_FGM842D_WIFI_SUPPORT
	QUEC_TARGET_DFLAGS  += -DQUEC_UART_DMA_RX_ENABLE -DQUEC_UART_DMA_TX_ENABLE
	QUEC_TARGET_DFLAGS  += -DQUEC_BT_UART_DMA_TX_ENABLE -DQUEC_BT_UART_DMA_RX_ENABLE
endif
endif

ifneq (,$(findstring EC800K,${QUECTEL_PROJECT})) 
ifneq (,$(findstring WIFI,${oem_ver}))
	QUEC_TARGET_DFLAGS  += -DQUEC_FGM842D_WIFI_SUPPORT
	QUEC_TARGET_DFLAGS  += -DQUEC_UART_DMA_RX_ENABLE -DQUEC_UART_DMA_TX_ENABLE
	QUEC_TARGET_DFLAGS  += -DQUEC_BT_UART_DMA_TX_ENABLE -DQUEC_BT_UART_DMA_RX_ENABLE
endif
endif

#EC600NCN_LC 16M+16M 项目 ASR-CRANEM
ifneq (,$(findstring EC600NCN_LC,${QUECTEL_PROJECT})) 
	QUEC_TARGET_DFLAGS  += -DASR_PLATFORM_CRANEM
endif

#EC600KCN_CC 2M+4M 项目 ASR-CRANELR   1602,单卡协议栈项目
ifneq (,$(findstring EC600KCN_CC,${QUECTEL_PROJECT})) 
	QUEC_TARGET_DFLAGS  += -DQUEC_NOAUDIO -D__CMUX_DISABLE
	QUEC_TARGET_DFLAGS  += -DQUEC_TTS_NOT_SUPPORT 
	QUEC_TARGET_DFLAGS  += -DQUEC_AMR_NOT_SUPPORT
	#QUEC_TARGET_DFLAGS  += -DQUEC_PPP_ENABLE
	#QUEC_TARGET_DFLAGS  += -DQUEC_ASR_SMS_ENABLE
	QUEC_TARGET_DFLAGS  += -DQUEC_MQTT_SUPPORT
	#QUEC_TARGET_DFLAGS  += -DQUEC_FTP_SUPPORT
	#QUEC_TARGET_DFLAGS  += -DQUEC_HTTP_SUPPORT

	QUEC_TARGET_DFLAGS += -DQUEC_CUST_FOR_IPC_SUPPORT
	QUEC_TARGET_DFLAGS += -DQUEC_CUST_FOR_POS_SUPPORT  

	##使用LFS_V2版本
	VARIANT_LIST        += NOAUDIO NOIMS LFS_SUPPORT_V2 NOL1WIFI NOPMIC803
	VARIANT_LIST        += CAT1ONLY_THIN NOATNET NOXML SD_NOT_SUPPORT NOPMIC813 NOPMICONKEY NOOSSL REMOVE_PB
	VARIANT_LIST        += NOLWM2M NOPAHO NOPMIC802 NODIALER

