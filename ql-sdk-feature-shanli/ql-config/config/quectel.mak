	QUEC_TARGET_DFLAGS  += -DQUEC_NOAUDIO -D__CMUX_DISABLE
	QUEC_TARGET_DFLAGS  += -DQUEC_TTS_NOT_SUPPORT 
	QUEC_TARGET_DFLAGS  += -DQUEC_AMR_NOT_SUPPORT
	QUEC_TARGET_DFLAGS  += -DQUEC_PPP_ENABLE
	QUEC_TARGET_DFLAGS  += -DQUEC_MQTT_SUPPORT
	QUEC_TARGET_DFLAGS  += -DQUEC_FTP_SUPPORT
	QUEC_TARGET_DFLAGS  += -DQUEC_HTTP_SUPPORT

	QUEC_TARGET_DFLAGS  += -DQUEC_CUST_FOR_IPC_SUPPORT
	QUEC_TARGET_DFLAGS  += -DQUEC_CUST_FOR_POS_SUPPORT  
	
	QUEC_TARGET_DFLAGS  += -DFEATURE_QUECTEL_LOCATOR_APP
	
	QUEC_TARGET_DFLAGS  += -DQUEC_ASR_SMS_ENABLE

	
	##使用LFS_V2版本
	VARIANT_LIST        += NOAUDIO NOIMS LFS_SUPPORT_V2 NOPMIC803
	VARIANT_LIST        += CAT1ONLY_THIN NOATNET NOXML SD_NOT_SUPPORT NOPMIC813 NOPMICONKEY NOOSSL REMOVE_PB
	VARIANT_LIST        += NOLWM2M NOPAHO NOPMIC802 NODIALER
	
	#ASR_5311 GNSS 
	ifeq (,$(findstring MIN_SYS,${VARIANT_LIST}))	
		QUEC_TARGET_DFLAGS	+= -DQUEC_UART_DMA_TX_ENABLE -DQUEC_UART_DMA_RX_ENABLE -DQUEC_UART2_ENABLE
		VARIANT_LIST  += QUEC_ASR_GPS AGPSTP_SUPPORT  
		TARGET_DFLAGS += -DQUEC_AT_GPS_ENABLE 
		TARGET_DFLAGS += -DQUEC_GPS_SUPPORT  -DQUEC_ASR_GNSS_SUPPORT -DGPS_SUPPORT -DQUEC_BT_UART_DMA_TX_ENABLE -DQUEC_BT_UART_DMA_RX_ENABLE
		PACKAGE_LIST +=  \
			quectel/gnss
			
		#add for 宇松gnss定制需求
		ifneq (,$(findstring BPC,${oem_ver}))
			QUEC_TARGET_DFLAGS  += -DYS_GNSS_SUPPORT
		endif
		#add for 单北斗定制需求
		ifneq (,$(findstring BD,${oem_ver}))
			QUEC_TARGET_DFLAGS  += -DQUEC_BD_GNSS_SUPPORT
		endif
    endif
endif

